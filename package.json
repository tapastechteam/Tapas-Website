{
  "name": "tapas-integrated",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "styles": "node scripts/build-styles.mjs",
    "prebuild": "npm run styles",
    "predev": "npm run styles",
    "typecheck": "tsc --noEmit",
    "setup:styles": "npm --prefix tools/team-styles ci --ignore-scripts --no-audit --no-fund",
    "verify:local": "node scripts/verify-local.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "motion": "^14.14.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.5.33",
    "postcss-selector-parser": "^7.1.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.0"
  }
}
